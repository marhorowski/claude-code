# Postgres (Vercel: Storage -> Neon/Postgres, skopiuj connection string)
DATABASE_URL="postgresql://user:pass@host:5432/db?sslmode=require"

# Hasło do logowania do panelu (wspólne dla zespołu)
APP_PASSWORD="zmien-mnie"
# Losowy ciąg min. 32 znaki do podpisywania sesji: openssl rand -base64 32
AUTH_SECRET="wygeneruj-losowy-ciag-min-32-znaki"

# Token Meta: najlepiej token System User z Business Managera z dostępem do kont klientów
# Uprawnienia: ads_read (wystarczy), business_management
META_ACCESS_TOKEN=""
META_API_VERSION="v23.0"

# Vercel ustawia go sam dla cronów, lokalnie dowolny ciąg
CRON_SECRET="lokalny-sekret"
