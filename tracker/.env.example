# Lokalnie: pełny adres bazy Postgres (schemat "tracker" dopisuje się automatycznie)
TRACKER_DATABASE_URL="postgresql://user:pass@localhost:5432/tracker"
# Pierwsze konto administratora zakłada się przy pierwszym logowaniu tymi danymi
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="zmien-mnie"
# Klucz do podpisywania ciasteczek sesji (długi, losowy; wymagany na produkcji)
SESSION_SECRET="dlugi-losowy-ciag-znakow"
