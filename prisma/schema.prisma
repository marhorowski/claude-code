generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("database_url_POSTGRES_PRISMA_URL")
}

model User {
  id         String         @id @default(cuid())
  email      String         @unique
  password   String
  name       String
  role       String         @default("CLOSER")
  clients    ClientAccess[]
  dailyForms DailyForm[]
  createdAt  DateTime       @default(now())
}

model Client {
  id              String            @id @default(cuid())
  name            String
  strategy        String            @default("Paid Lead Gen")
  dataStartDate   DateTime?
  createdAt       DateTime          @default(now())
  kpiTargets      KpiTarget[]
  dailyForms      DailyForm[]
  weeklyForms     WeeklyForm[]
  monthlyForms    MonthlyForm[]
  quarterlyForms  QuarterlyForm[]
  accesses        ClientAccess[]
  bottlenecks     Bottleneck[]
  salesSettings   SalesSettings?
  formTokens      PublicFormToken[]
  dismissedAlerts DismissedAlert[]
}

model ClientAccess {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId String

  @@unique([userId, clientId])
}

model KpiTarget {
  id            String  @id @default(cuid())
  client        Client  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  code          String
  label         String
  target        Float
  unit          String
  period        String
  lowerIsBetter Boolean @default(false)
  visible       Boolean @default(true)
}

model DailyForm {
  id                String   @id @default(cuid())
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId          String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  date              DateTime
  // Sprzedaż (Closing)
  plannedMeetings    Int?    // zaplanowane spotkania (pierwsze)
  attendedMeetings   Int?    // odbyte spotkania
  cancelledMeetings  Int?    // odwołane spotkania
  postponedMeetings  Int?    // przełożone spotkania
  noShows            Int?    // no show
  closings           Int?    // domknięte sprzedaże
  revenue            Float?  // przychód z nowych domknięć
  followUpsDone      Int?    // follow-upy odbyte dzisiaj
  followUpClosings   Int?    // domknięcia z follow-upów
  followUpRevenue    Float?  // przychód z domknięć follow-upowych
  // Setting
  callsMade          Int?    // wykonane telefony
  conductedCalls     Int?    // przeprowadzone rozmowy
  meetingsBooked     Int?    // umówione spotkania
  // Marketing
  dailyAdSpend       Float?  // wydatek na reklamy
  dailyImpressions   Int?    // wyświetlenia
  dailyClicks        Int?    // unikatowe kliknięcia linku
  dailyLeads         Int?    // liczba leadów
  optinConversion    Float?  // konwersja optin page (%)
  vslMeetingsBooked  Int?    // umówione rozmowy z marketingu
  // Legacy fields (kept for old data)
  callsReceived        Int?
  followUpCount        Int?
  unqualifiedMeetings  Int?
  meetingFollowUps     Int?
  dailyCtr             Float?
  notes                String?
  createdAt         DateTime @default(now())
}

model WeeklyForm {
  id                   String    @id @default(cuid())
  client               Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId             String
  weekNumber           Int
  year                 Int
  weekStart            DateTime
  weekEnd              DateTime
  totalLeads           Int       @default(0)
  totalCallsMade       Int       @default(0)
  totalMeetingsBooked  Int       @default(0)
  totalPlannedMeetings Int       @default(0)
  totalAttended        Int       @default(0)
  totalClosings        Int       @default(0)
  totalRevenue         Float     @default(0)
  adSpend              Float?
  cpl                  Float?
  notes                String?
  lockedAt             DateTime?
  createdAt            DateTime  @default(now())

  @@unique([clientId, weekNumber, year])
}

model MonthlyForm {
  id            String   @id @default(cuid())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  month         Int
  year          Int
  targetRevenue Float?
  enge          Float?
  aov           Float?
  ar            Float?
  leadToClose   Float?
  notes         String?
  // Historical aggregate actuals (for months before app was used)
  histRevenue   Float?
  histLeads     Int?
  histBooked    Int?
  histAttended  Int?
  histClosings  Int?
  histAdSpend   Float?
  histSur       Float?
  histCp        Float?
  createdAt     DateTime @default(now())

  @@unique([clientId, month, year])
}

model QuarterlyForm {
  id            String   @id @default(cuid())
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId      String
  quarter       Int
  year          Int
  targetRevenue Float?
  ltv           Float?
  alpvc         Float?
  notes         String?
  createdAt     DateTime @default(now())

  @@unique([clientId, quarter, year])
}

model SalesSettings {
  id                  String @id @default(cuid())
  client              Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId            String @unique
  dealSize            Float  @default(0)
  closerCommissionPct Float  @default(0)
  setterCommissionPct Float  @default(0)
  fixedMonthlyCosts   Float  @default(0)
  leadToMeetingRate   Float  @default(0)
  setterBookingRate   Float  @default(0)
  vslConversionRate   Float  @default(0)
}

model PublicFormToken {
  id        String    @id @default(cuid())
  client    Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  userId    String?
  token     String    @unique @default(cuid())
  label     String    @default("")
  createdAt DateTime  @default(now())
}

model DismissedAlert {
  id        String   @id @default(cuid())
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId  String
  userId    String
  alertKey  String
  createdAt DateTime @default(now())

  @@unique([userId, clientId, alertKey])
}

model Bottleneck {
  id          String    @id @default(cuid())
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId    String
  kpiCode     String
  title       String
  description String
  actions     String
  status      String    @default("ACTIVE")
  isAuto      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  resolvedAt  DateTime?
}
